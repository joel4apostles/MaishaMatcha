# Resend — waitlist audience + confirmation email.
# Missing values in dev are tolerated: the API logs the payload and returns success.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Optional — defaults to "maisha matcha <hola@maishamatcha.es>".
RESEND_FROM=

# Canonical site origin, used for metadata / OG / sitemap.
NEXT_PUBLIC_SITE_URL=https://maishamatcha.es

# Payload CMS admin (/admin) and the counter (/pos).
# Signs admin and POS cookies. 32+ random characters: openssl rand -base64 48
PAYLOAD_SECRET=
# Postgres. Unset locally = the docker-compose db (npm run db:up).
# Production: Supabase "Transaction pooler" URI (port 6543). On Vercel set it
# for the PRODUCTION environment only, so preview builds never migrate prod.
DATABASE_URL=
# Production only: the email allowed to create the first (owner) account.
FIRST_OWNER_EMAIL=

# Stripe (Phase 2 — founding membership checkout). Not read by any code yet.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=


# Cloudflare Turnstile (free): bot check on the waitlist, sign-in and order
# forms. Both empty = off (the shared rate limits still apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
