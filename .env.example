# Resend — waitlist audience + confirmation email.
# Missing values in dev are tolerated: the API logs the payload and returns success.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Optional — defaults to "maisha matcha <hola@maishamatcha.es>".
RESEND_FROM=

# Canonical site origin, used for metadata / OG / sitemap.
NEXT_PUBLIC_SITE_URL=https://maishamatcha.es

# Payload CMS admin (/admin).
# Secret signs auth cookies — set a long random string in production.
PAYLOAD_SECRET=
# Postgres connection. REQUIRED in production; local dev falls back to a
# SQLite file (payload.db) when unset. Supabase works great: use the
# "Transaction pooler" URI (port 6543) for Vercel serverless — switch to the
# direct URI (5432) only if a migration step complains. Neon / Vercel
# Postgres are equally fine.
DATABASE_URL=
